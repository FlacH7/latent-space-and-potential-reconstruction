# Test-Retest Database
DB_TEST_RETEST_PATH=/route/to/your/ds004148

# Test-Retest with Gedai preprocessing Database
DB_TEST_RETEST_GEDAI_PATH=/route/to/your/gedai/database

# ANPHY-Sleep Database
DB_ANPHY_PATH=/route/to/your/ANPHY-Sleep

# Siena Scalp EEG Database
DB_SIENA_PATH=/route/to/your/siena-scalp-eeg/1.0.0/

# Ludovico 01 Database
DB_LUDOVICO_01_PATH=/route/to/your/ludovico_01

# Cross-repo CD-HSA handoff (RUTAS PRIVADAS: este fichero es .env, gitignored).
# CDHSA_PARAMS_DIR  : directorio donde el repo de CD-HSA guarda mode_map_*.json
#                     (BASE_PARAMS_FILE del .env de ese repo, tipicamente <repo-cdhsa>/params)
# CDHSA_RESULTS_DIR : directorio de la corrida CD-HSA que contiene cdhsa_arrays.npz
#                     (results/cdhsa/<session>/<tag>/<filtro>/<ventana_tareas>)
# Se referencan desde el JSON del batch con placeholders:
#   "mode_map_path": "${CDHSA_PARAMS_DIR}/mode_map_...json"
#   "npz_path":      "${CDHSA_RESULTS_DIR}/cdhsa_arrays.npz"
CDHSA_PARAMS_DIR=/route/to/your/cdhsa/repo/params
CDHSA_RESULTS_DIR=/route/to/your/cdhsa/repo/results/cdhsa/session1/<tag_de_la_corrida>

# Cache
BASE_CACHE_PATH=./cache
DATA_SIMULATIONS_CACHE_PATH=./cache/sim_cache

# Results
BASE_RESULTS_PATH=./results
BASE_PARAMS_FILE=./params

# Logging
LOGGING_BASE_PATH=./logs
LOGGING_LEVEL=INFO

# Batch runs
DEFAULT_BATCH_RUNS_WORKERS=1
